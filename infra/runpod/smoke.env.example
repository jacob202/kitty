# Kitty Image Studio — guarded RunPod Pod smoke-test configuration
#
# Copy this file outside git tracking, for example:
#   cp infra/runpod/smoke.env.example .env.runpod.local
#   set -a; source .env.runpod.local; set +a
#
# `.env.runpod.local` is ignored by the repository's `.env.*.local` rule.
# This milestone uses the RunPod REST API and authenticated HTTP worker.
# SSH is not required.

# Required for every live RunPod control-plane call.
RUNPOD_API_KEY=

# Jacob's current RunPod Pod template.
RUNPOD_TEMPLATE_ID=2lv7ev3wfp

# Required by the Kitty worker. Generate a long random value locally.
KITTY_WORKER_BEARER_TOKEN=

# Optional persistent model storage. Leave blank for a disposable smoke test.
RUNPOD_NETWORK_VOLUME_ID=

# Ordered GPU candidates accepted by the smoke test.
RUNPOD_GPU_TYPE_IDS=NVIDIA GeForce RTX 3090,NVIDIA RTX A5000,NVIDIA GeForce RTX 4090

# Cost and lifecycle guards.
RUNPOD_MAX_HOURLY_RATE=0.50
RUNPOD_HARD_RUNTIME_MINUTES=120
RUNPOD_READY_TIMEOUT_SECONDS=600
RUNPOD_GENERATION_TIMEOUT_SECONDS=420
RUNPOD_POLL_INTERVAL_SECONDS=4

# Worker/ComfyUI paths inside the custom image.
COMFYUI_ROOT=/workspace/ComfyUI
COMFY_URL=http://127.0.0.1:8188
KITTY_WORKFLOW_ROOT=/opt/kitty/workflows
KITTY_JOB_ROOT=/workspace/jobs
KITTY_WORKER_PORT=8000
KITTY_MAX_REQUEST_BYTES=131072

# The checkpoint filename already installed in the ComfyUI template/container.
COMFY_CHECKPOINT=RealCoreXL.safetensors
KITTY_ALLOWED_CHECKPOINTS=RealCoreXL.safetensors
COMFY_WIDTH=1024
COMFY_HEIGHT=1024
COMFY_STEPS=20
COMFY_CFG=5.0
COMFY_NEGATIVE_PROMPT=worst quality, low quality, bad anatomy, deformed, watermark, text

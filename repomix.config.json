{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "artifacts/repo-context/kitty-codebase.xml",
    "style": "xml",
    "parsableStyle": true,
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 20
  },
  "include": [
    "README.md",
    "START_HERE.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "pyproject.toml",
    "requirements*.txt",
    "Makefile",
    "kitty",
    "gateway/**/*",
    "contracts/**/*",
    "soul/**/*",
    "config/**/*",
    "mcp/**/*",
    "scripts/**/*",
    "tests/**/*",
    "docs/README.md",
    "docs/AUTHORITY_MAP.md",
    "docs/NORTH_STAR.md",
    "docs/ARCHITECTURE.md",
    "docs/DECISIONS.md",
    "docs/ROADMAP.md",
    "docs/PROJECT_STATUS.md",
    "docs/ACTIVE_MISSION.md",
    "docs/FEATURE_REALITY_2026-07-28.md",
    "docs/CODEBASE_MAP.md",
    "docs/adr/**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".env*",
      "**/*secret*",
      "**/*credential*",
      "**/*token*",
      "data/**",
      "logs/**",
      "artifacts/**",
      "docs/archive/**",
      "docs/retired/**",
      "docs/plans/**",
      "docs/planning/**",
      "docs/packets/**",
      "docs/phases/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/coverage/**",
      "**/*.db",
      "**/*.sqlite*",
      "**/*.log",
      "**/*.jsonl",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.mp3",
      "**/*.wav",
      "**/*.mp4",
      "**/*.zip"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}

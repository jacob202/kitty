{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitty.local/contracts/image-character-v1.json",
  "title": "Kitty Image Character",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_id",
    "name",
    "description",
    "identity",
    "prompt",
    "recipe"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "character_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appearance", "preserve", "exclude"],
      "properties": {
        "appearance": {"type": "string", "minLength": 1},
        "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "base_family", "fusion_method", "references"],
      "properties": {
        "method": {
          "enum": [
            "description_only",
            "lora",
            "pulid",
            "instantid",
            "ipadapter_faceid",
            "trained_adapter"
          ]
        },
        "base_family": {"type": "string", "minLength": 1},
        "adapter_model": {"type": ["string", "null"]},
        "adapter_strength": {"type": "number", "minimum": 0, "maximum": 2},
        "fusion_method": {
          "enum": ["single", "equal_mean", "weighted_mean", "concat", "max"]
        },
        "allow_generated_derivatives": {"type": "boolean", "default": false},
        "references": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_id",
              "purpose",
              "provenance",
              "enabled",
              "weight",
              "face_weight",
              "body_weight",
              "quality_score"
            ],
            "properties": {
              "ref_id": {"type": "string", "minLength": 1},
              "purpose": {
                "enum": [
                  "primary_face",
                  "secondary_face",
                  "profile",
                  "body_build",
                  "hair",
                  "expression",
                  "style_only"
                ]
              },
              "provenance": {"enum": ["real_photo", "generated_derivative"]},
              "enabled": {"type": "boolean"},
              "weight": {"type": "number", "minimum": 0, "maximum": 1},
              "face_weight": {"type": "number", "minimum": 0, "maximum": 1},
              "body_weight": {"type": "number", "minimum": 0, "maximum": 1},
              "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "string"},
        "negative": {"type": "string"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": true,
      "required": ["recipe_id", "engine"],
      "properties": {
        "recipe_id": {"type": "string", "minLength": 1},
        "engine": {"type": "string", "minLength": 1},
        "sampler": {"type": ["string", "null"]},
        "scheduler": {"type": ["string", "null"]},
        "steps": {"type": ["integer", "null"], "minimum": 1},
        "guidance": {"type": ["number", "null"]},
        "denoise": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}

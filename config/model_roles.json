{
  "schema_version": 1,
  "discovery": {
    "cadence_days": 7,
    "automatic_promotion": false,
    "sources": [
      "configured provider model catalogues",
      "provider release notes",
      "operator-nominated candidates"
    ]
  },
  "evaluation": {
    "minimum_representative_tasks": 30,
    "repeat_windows": 2,
    "maximum_critical_regressions": 0,
    "maximum_malformed_rate": 0.02,
    "maximum_success_rate_regression": 0.02,
    "quality_improvement_required": 0.05,
    "cost_reduction_required": 0.25,
    "latency_reduction_required": 0.30,
    "maximum_tool_success_regression": 0.02
  },
  "roles": {
    "auto": {
      "kind": "router",
      "public_name": "Daily Kitty",
      "route": "kitty-default",
      "purpose": "Classify the turn and select the cheapest role that can complete it reliably.",
      "incumbent": null,
      "required_metrics": [
        "routing_accuracy",
        "accepted_outcome_rate",
        "cost_per_accepted_outcome",
        "median_time_to_accepted_outcome"
      ]
    },
    "fast": {
      "kind": "model_role",
      "public_name": "Quick",
      "route": "kitty-small",
      "purpose": "Routine, bounded, low-risk work where latency and cost matter.",
      "incumbent": {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4-flash"
      },
      "representative_work": [
        "rewrite",
        "summarize",
        "extract",
        "classify",
        "small bounded code edit"
      ],
      "required_metrics": [
        "accepted_outcome_rate",
        "cost_per_accepted_outcome",
        "median_time_to_accepted_outcome",
        "malformed_rate",
        "tool_success_rate",
        "critical_regressions"
      ]
    },
    "think": {
      "kind": "model_role",
      "public_name": "Think",
      "route": "kitty-think",
      "purpose": "Ambiguous planning, architecture, synthesis, and difficult debugging.",
      "incumbent": {
        "provider": "openrouter",
        "model": "qwen/qwen3-235b-a22b-thinking-2507"
      },
      "representative_work": [
        "architecture decision",
        "root cause analysis",
        "multi-source synthesis",
        "consequential planning"
      ],
      "required_metrics": [
        "accepted_outcome_rate",
        "cost_per_accepted_outcome",
        "median_time_to_accepted_outcome",
        "malformed_rate",
        "tool_success_rate",
        "critical_regressions"
      ]
    },
    "code": {
      "kind": "model_role",
      "public_name": "Code",
      "route": "kitty-code",
      "purpose": "Repository implementation, debugging, and verified patches.",
      "incumbent": {
        "provider": "openrouter",
        "model": "qwen/qwen3-coder"
      },
      "representative_work": [
        "fix failing test",
        "implement bounded packet",
        "review patch",
        "debug runtime failure"
      ],
      "required_metrics": [
        "accepted_outcome_rate",
        "cost_per_accepted_outcome",
        "median_time_to_accepted_outcome",
        "malformed_rate",
        "tool_success_rate",
        "critical_regressions"
      ]
    },
    "vision": {
      "kind": "model_role",
      "public_name": "Vision",
      "route": "kitty-vision",
      "purpose": "Screenshots, documents, UI inspection, photographs, and multimodal turns.",
      "incumbent": {
        "provider": "openrouter",
        "model": "mistralai/mistral-small-3.2-24b-instruct"
      },
      "representative_work": [
        "screenshot diagnosis",
        "document layout reading",
        "photo detail analysis",
        "multimodal question answering"
      ],
      "required_metrics": [
        "accepted_outcome_rate",
        "cost_per_accepted_outcome",
        "median_time_to_accepted_outcome",
        "malformed_rate",
        "tool_success_rate",
        "critical_regressions"
      ]
    }
  }
}

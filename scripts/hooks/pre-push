#!/usr/bin/env bash
# Run the Tests workflow's gates before anything leaves this machine.
#
# GitHub Actions is the usual gate. When it cannot run — no runner minutes, no
# network, no budget — a push carries no verdict at all, and broken code reaches
# main unnoticed. This hook is the standing local replacement: same commands,
# same thresholds, no account required.
#
# Install: make hooks
# Bypass:  git push --no-verify   (deliberate, and it says so in the output)
set -uo pipefail

PREFLIGHT=0
REMOTE_NAME=""
REMOTE_URL=""
if [[ "${1:-}" == "--preflight" ]]; then
  PREFLIGHT=1
  shift
  if [[ $# -ne 0 ]]; then
    printf 'usage: %s [--preflight]\n' "$0" >&2
    exit 2
  fi
else
  # Git invokes pre-push as: <hook> <remote-name> <remote-url>.
  # A manual no-argument invocation is still supported for local parity runs.
  if [[ $# -gt 2 ]]; then
    printf 'usage: %s [--preflight] OR %s [remote-name remote-url]\n' "$0" "$0" >&2
    exit 2
  fi
  REMOTE_NAME="${1:-}"
  REMOTE_URL="${2:-}"
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "${ROOT_DIR}" || exit 1

# Git exports repository-local GIT_* variables to hooks. Clear them before
# launching tests so nested temporary repos use their own .git directories.
while IFS= read -r var; do
  [[ -n "${var}" ]] && unset "${var}"
done < <(git rev-parse --local-env-vars)

# Builder runs intentionally route queue state through a per-run data directory.
# CI does not set that override, so scrub it before CI-parity gates; otherwise
# tests observe the live proof database instead of their repository-local fixtures.
unset KITTY_BUILDER_DATA_DIR

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
[[ -t 2 ]] || { RED=""; GREEN=""; YELLOW=""; DIM=""; OFF=""; }

say() { printf '%s\n' "$*" >&2; }

# Local safety belt: normal delivery reaches main through a reviewed PR.
# Server-side required checks are the authoritative enforcement.
if [[ "${PREFLIGHT}" != "1" ]]; then
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "${remote_ref}" == "refs/heads/main" && "${KITTY_ALLOW_DIRECT_MAIN_PUSH:-0}" != "1" ]]; then
      say "${RED}Push blocked — direct push to main.${OFF}"
      say "Open/merge a PR instead. Emergency local-hook override: KITTY_ALLOW_DIRECT_MAIN_PUSH=1 git push ..."
      exit 1
    fi
  done
fi

# Fail loud rather than waving a push through on a half-built toolchain. A gate
# that silently skips is worse than no gate: it reports success it never checked.
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
CANONICAL_ROOT="${ROOT_DIR}"
if [[ -n "${COMMON_DIR}" && "$(basename "${COMMON_DIR}")" == ".git" ]]; then
  CANONICAL_ROOT="$(dirname "${COMMON_DIR}")"
fi

PYTHON_BIN="${PYTHON_BIN:-${ROOT_DIR}/venv/bin/python}"
if [[ ! -x "${PYTHON_BIN}" && -x "${CANONICAL_ROOT}/venv/bin/python" ]]; then
  PYTHON_BIN="${CANONICAL_ROOT}/venv/bin/python"
fi
if [[ ! -x "${PYTHON_BIN}" ]]; then
  if command -v python3.12 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3.12)"
  else
    say "${RED}Push blocked — no Python to test with.${OFF}"
    say "Looked for the worktree/canonical Kitty venv and python3.12, found none."
    say "Fix: python3.12 -m venv venv && ./venv/bin/pip install -r requirements.txt"
    [[ "${PREFLIGHT}" == "1" ]] && exit 75
    exit 1
  fi
fi

RUFF="${ROOT_DIR}/venv/bin/ruff"
[[ -x "${RUFF}" ]] || RUFF=""

if ! git --version >/dev/null 2>&1; then
  say "Publication blocked — Git is unavailable."
  exit 75
fi
if ! "${PYTHON_BIN}" -c 'import mypy, pytest, ruff' >/dev/null 2>&1; then
  say "Publication blocked — Ruff, mypy, or pytest is unavailable to the selected Python."
  exit 75
fi
if [[ "${PREFLIGHT}" == "1" ]]; then
  say "Publication environment preflight passed."
  exit 0
fi

# Frontend gates cost several minutes and only matter when the frontend moved.
# Everything else runs every time — the last two breakages on main were both
# docs-only changes.
BASE_REF="$(git rev-parse --verify --quiet origin/main || true)"
if [[ -n "${BASE_REF}" ]]; then
  CHANGED="$(git diff --name-only "${BASE_REF}...HEAD" 2>/dev/null || true)"
else
  CHANGED=""
fi
if [[ -z "${BASE_REF}" ]] || grep -q '^gateway/kitty-chat/' <<<"${CHANGED}"; then
  RUN_FRONTEND=1
else
  RUN_FRONTEND=0
fi

FAILED=()
INFRA_FAILED=0
run_gate() {
  local label="$1"; shift
  local gate_rc=0
  say "${DIM}→ ${label}${OFF}"
  "$@" >/tmp/kitty-pre-push.$$ 2>&1 || gate_rc=$?
  if [[ ${gate_rc} -eq 0 ]]; then
    say "  ${GREEN}ok${OFF}  ${label}"
  else
    say "  ${RED}FAILED${OFF}  ${label}"
    tail -n 25 /tmp/kitty-pre-push.$$ >&2
    FAILED+=("${label}")
    if [[ ${gate_rc} -eq 75 || ${gate_rc} -eq 126 || ${gate_rc} -eq 127 ]]; then
      INFRA_FAILED=1
    fi
  fi
  rm -f /tmp/kitty-pre-push.$$
}

say ""
say "Checking before push — the same gates CI runs."

if [[ -n "${RUFF}" ]]; then
  run_gate "code style" "${RUFF}" check gateway/ tests/ mcp/ workers/ scripts/runpod_worker_smoke_test.py
else
  run_gate "code style" "${PYTHON_BIN}" -m ruff check gateway/ tests/ mcp/ workers/ scripts/runpod_worker_smoke_test.py
fi

run_gate "types" "${PYTHON_BIN}" -m mypy gateway/ mcp/ workers/ scripts/runpod_worker_smoke_test.py

export KITTY_EXPECTED_TEST_CHECKOUT="${ROOT_DIR}"
export KITTY_EXPECTED_TEST_HEAD="$(git rev-parse HEAD)"
run_gate "tests" "${PYTHON_BIN}" -m pytest tests/ -q --tb=short \
  --cov=gateway --cov-report=term-missing --cov-fail-under=73

if [[ "${RUN_FRONTEND}" == "1" ]]; then
  run_gate "web tests" bash -c 'cd gateway/kitty-chat && ./node_modules/.bin/vitest run'
  run_gate "web build" bash -c 'cd gateway/kitty-chat && node node_modules/next/dist/bin/next build'
else
  say "  ${DIM}skipped${OFF}  web tests and build — nothing under gateway/kitty-chat/ changed"
fi

say ""
if [[ ${#FAILED[@]} -eq 0 ]]; then
  say "${GREEN}All clear.${OFF} Pushing."
  say ""
  exit 0
fi

if [[ "${INFRA_FAILED}" == "1" ]]; then
  say "${RED}Push blocked by publication infrastructure.${OFF} ${#FAILED[@]} gate(s) could not run reliably: ${FAILED[*]}"
  say ""
  exit 75
fi

say "${RED}Push blocked.${OFF} ${#FAILED[@]} of these failed: ${FAILED[*]}"
say ""
say "Nothing was sent. Fix the failure above, or run ${YELLOW}make ci${OFF} to see it in full."
say "If you are certain this is fine, push again with ${YELLOW}--no-verify${OFF}."
say ""
exit 1

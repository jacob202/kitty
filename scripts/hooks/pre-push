#!/usr/bin/env bash
# Keep publication safe without making every intermediate push pay full CI cost.
#
# Normal feature pushes enforce Git-history safety, environment admission, and
# bounded changed-scope checks. Ready-PR GitHub Actions is the authoritative full
# delivery gate. Use --full (or make ci) when explicit local parity is needed,
# such as an offline/no-runner delivery path.
#
# Install: make hooks
# Bypass:  git push --no-verify   (deliberate, and it says so in the output)
set -uo pipefail

PREFLIGHT=0
FULL=0
REMOTE_NAME=""
REMOTE_URL=""
while [[ "${1:-}" == --* ]]; do
  case "${1}" in
    --preflight) PREFLIGHT=1 ;;
    --full) FULL=1 ;;
    *)
      printf 'usage: %s [--preflight | --full] [remote-name remote-url]\n' "$0" >&2
      exit 2
      ;;
  esac
  shift
done
if [[ "${PREFLIGHT}" == "1" && "${FULL}" == "1" ]]; then
  printf 'usage: %s [--preflight | --full] [remote-name remote-url]\n' "$0" >&2
  exit 2
fi
if [[ "${PREFLIGHT}" == "1" && $# -ne 0 ]]; then
  printf 'usage: %s --preflight\n' "$0" >&2
  exit 2
fi
if [[ $# -gt 2 ]]; then
  printf 'usage: %s [--full] [remote-name remote-url]\n' "$0" >&2
  exit 2
fi
# Git invokes pre-push as: <hook> <remote-name> <remote-url>.
# A manual no-argument invocation is still supported for local parity runs.
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "${ROOT_DIR}" || exit 1

# Git exports repository-local GIT_* variables to hooks. Clear them before
# launching tests so nested temporary repos use their own .git directories.
while IFS= read -r var; do
  [[ -n "${var}" ]] && unset "${var}"
done < <(git rev-parse --local-env-vars)

# Builder runs intentionally route queue state through a per-run data directory.
# CI does not set that override, so scrub it before CI-parity gates; otherwise
# tests observe the live proof database instead of their repository-local fixtures.
unset KITTY_BUILDER_DATA_DIR

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
[[ -t 2 ]] || { RED=""; GREEN=""; YELLOW=""; DIM=""; OFF=""; }

say() { printf '%s\n' "$*" >&2; }

# Local safety belt: normal delivery reaches main through a reviewed PR.
# Server-side required checks are the authoritative enforcement.
if [[ "${PREFLIGHT}" != "1" ]]; then
  ZERO_SHA="0000000000000000000000000000000000000000"
  while read -r _local_ref local_sha remote_ref remote_sha; do
    if [[ "${remote_ref}" == "refs/heads/main" && "${KITTY_ALLOW_DIRECT_MAIN_PUSH:-0}" != "1" ]]; then
      say "${RED}Push blocked — direct push to main.${OFF}"
      say "Open/merge a PR instead. Emergency local-hook override: KITTY_ALLOW_DIRECT_MAIN_PUSH=1 git push ..."
      exit 1
    fi

    # Shared doctrine forbids history rewrites, including --force-with-lease.
    # Enforce the invariant from the ref update itself rather than guessing
    # which git-push flag spelling produced it.
    if [[ "${local_sha}" != "${ZERO_SHA}" && "${remote_sha}" != "${ZERO_SHA}" ]]; then
      if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        say "${RED}Push blocked — remote tip ${remote_sha:0:12} is not present locally.${OFF}"
        say "Fetch the remote branch and retry; refusing an unverifiable history update."
        exit 1
      fi
      if ! git merge-base --is-ancestor "${remote_sha}" "${local_sha}"; then
        say "${RED}Push blocked — non-fast-forward history rewrite detected for ${remote_ref}.${OFF}"
        say "Force-push and --force-with-lease are forbidden. Publish a new commit/branch instead."
        exit 1
      fi
    fi
  done
fi

# Fail loud rather than waving a push through on a half-built toolchain. A gate
# that silently skips is worse than no gate: it reports success it never checked.
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
CANONICAL_ROOT="${ROOT_DIR}"
if [[ -n "${COMMON_DIR}" && "$(basename "${COMMON_DIR}")" == ".git" ]]; then
  CANONICAL_ROOT="$(dirname "${COMMON_DIR}")"
fi

PYTHON_BIN="${PYTHON_BIN:-${ROOT_DIR}/venv/bin/python}"
if [[ ! -x "${PYTHON_BIN}" && -x "${CANONICAL_ROOT}/venv/bin/python" ]]; then
  PYTHON_BIN="${CANONICAL_ROOT}/venv/bin/python"
fi
if [[ ! -x "${PYTHON_BIN}" ]]; then
  if command -v python3.12 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3.12)"
  else
    say "${RED}Push blocked — no Python to test with.${OFF}"
    say "Looked for the worktree/canonical Kitty venv and python3.12, found none."
    say "Fix: python3.12 -m venv venv && ./venv/bin/pip install -r requirements.txt"
    [[ "${PREFLIGHT}" == "1" ]] && exit 75
    exit 1
  fi
fi

RUFF="${ROOT_DIR}/venv/bin/ruff"
[[ -x "${RUFF}" ]] || RUFF=""

if ! git --version >/dev/null 2>&1; then
  say "Publication blocked — Git is unavailable."
  exit 75
fi
if ! "${PYTHON_BIN}" -c 'import mypy, pytest, ruff' >/dev/null 2>&1; then
  say "Publication blocked — Ruff, mypy, or pytest is unavailable to the selected Python."
  exit 75
fi
if [[ "${PREFLIGHT}" == "1" ]]; then
  say "Publication environment preflight passed."
  exit 0
fi

# Classify the candidate against origin/main. If that base is unavailable we
# cannot prove a narrow scope, so widen to the explicit full gate instead of
# guessing. Documentation matches scripts.pr_scope: docs/ or *.md/*.mdx.
BASE_REF="$(git rev-parse --verify --quiet origin/main || true)"
if [[ -n "${BASE_REF}" ]]; then
  CHANGED="$(git diff --name-only "${BASE_REF}...HEAD" 2>/dev/null || true)"
else
  CHANGED=""
  FULL=1
fi
CODE_CHANGED="$(printf '%s\n' "${CHANGED}" | grep -Ev '(^docs/|\.(md|mdx)$)' || true)"
FRONTEND_CHANGED="$(printf '%s\n' "${CHANGED}" | grep '^gateway/kitty-chat/' | grep -Ev '\.(md|mdx)$' || true)"
if [[ -z "${BASE_REF}" ]] || [[ -n "${CODE_CHANGED}" ]]; then
  RUN_CODE=1
else
  RUN_CODE=0
fi
if [[ -z "${BASE_REF}" ]] || [[ -n "${FRONTEND_CHANGED}" ]]; then
  RUN_FRONTEND=1
else
  RUN_FRONTEND=0
fi

CHANGED_PYTHON_FILES=()
CHANGED_TEST_FILES=()
while IFS= read -r path; do
  [[ -n "${path}" ]] || continue
  if [[ "${path}" == *.py ]]; then
    CHANGED_PYTHON_FILES+=("${path}")
  fi
  if [[ "${path}" == tests/* && "${path##*/}" == test_*.py ]]; then
    CHANGED_TEST_FILES+=("${path}")
  fi
done <<< "${CHANGED}"

FAILED=()
INFRA_FAILED=0
run_gate() {
  local label="$1"; shift
  local gate_rc=0
  say "${DIM}→ ${label}${OFF}"
  "$@" >/tmp/kitty-pre-push.$$ 2>&1 || gate_rc=$?
  if [[ ${gate_rc} -eq 0 ]]; then
    say "  ${GREEN}ok${OFF}  ${label}"
  else
    say "  ${RED}FAILED${OFF}  ${label}"
    tail -n 25 /tmp/kitty-pre-push.$$ >&2
    FAILED+=("${label}")
    if [[ ${gate_rc} -eq 75 || ${gate_rc} -eq 126 || ${gate_rc} -eq 127 ]]; then
      INFRA_FAILED=1
    fi
  fi
  rm -f /tmp/kitty-pre-push.$$
}

run_bounded_gates() {
  say ""
  say "Checking before push — bounded changed-scope checks. Ready-PR CI is authoritative."
  if [[ "${RUN_CODE}" != "1" ]]; then
    say "  ${DIM}skipped${OFF}  code gates — documentation-only change"
    return
  fi

  if [[ ${#CHANGED_PYTHON_FILES[@]} -gt 0 ]]; then
    if [[ -n "${RUFF}" ]]; then
      run_gate "changed code style" "${RUFF}" check "${CHANGED_PYTHON_FILES[@]}"
    else
      run_gate "changed code style" "${PYTHON_BIN}" -m ruff check "${CHANGED_PYTHON_FILES[@]}"
    fi
  else
    say "  ${DIM}skipped${OFF}  changed code style — no changed Python files"
  fi

  if [[ ${#CHANGED_TEST_FILES[@]} -gt 0 ]]; then
    run_gate "changed tests" "${PYTHON_BIN}" -m pytest "${CHANGED_TEST_FILES[@]}" \
      -q --tb=short -o addopts="--strict-markers" -m "not controlled_live"
  else
    say "  ${DIM}skipped${OFF}  changed tests — no changed Python test files"
  fi

  if [[ "${RUN_FRONTEND}" == "1" ]]; then
    run_gate "web tests" bash -c 'cd gateway/kitty-chat && ./node_modules/.bin/vitest run --maxWorkers=2'
  fi
}

run_full_gates() {
  say ""
  say "Checking before push — full local parity gate."
  if [[ "${RUN_CODE}" != "1" ]]; then
    say "  ${DIM}skipped${OFF}  full code gates — documentation-only change"
    return
  fi

  if [[ -n "${RUFF}" ]]; then
    run_gate "code style" "${RUFF}" check gateway/ tests/ mcp/ workers/ scripts/runpod_worker_smoke_test.py
  else
    run_gate "code style" "${PYTHON_BIN}" -m ruff check gateway/ tests/ mcp/ workers/ scripts/runpod_worker_smoke_test.py
  fi
  run_gate "types" "${PYTHON_BIN}" -m mypy gateway/ mcp/ workers/ scripts/runpod_worker_smoke_test.py

  # CI gives frontend and Python separate runners. Keep frontend first locally
  # so coverage does not push the 8 GB host into swap before Vitest/build.
  if [[ "${RUN_FRONTEND}" == "1" ]]; then
    run_gate "web tests" bash -c 'cd gateway/kitty-chat && ./node_modules/.bin/vitest run --maxWorkers=2'
    run_gate "web build" bash -c 'cd gateway/kitty-chat && node node_modules/next/dist/bin/next build'
  else
    say "  ${DIM}skipped${OFF}  web tests and build — nothing under gateway/kitty-chat/ changed"
  fi

  export KITTY_EXPECTED_TEST_CHECKOUT="${ROOT_DIR}"
  export KITTY_EXPECTED_TEST_HEAD="$(git rev-parse HEAD)"
  run_gate "tests" "${PYTHON_BIN}" -m pytest tests/ -q --tb=short \
    --cov=gateway --cov-report=term-missing --cov-fail-under=73
}

if [[ "${FULL}" == "1" ]]; then
  run_full_gates
else
  run_bounded_gates
fi

say ""
if [[ ${#FAILED[@]} -eq 0 ]]; then
  say "${GREEN}All clear.${OFF} Pushing."
  say ""
  exit 0
fi

if [[ "${INFRA_FAILED}" == "1" ]]; then
  say "${RED}Push blocked by publication infrastructure.${OFF} ${#FAILED[@]} gate(s) could not run reliably: ${FAILED[*]}"
  say ""
  exit 75
fi

say "${RED}Push blocked.${OFF} ${#FAILED[@]} of these failed: ${FAILED[*]}"
say ""
say "Nothing was sent. Fix the failure above, or run ${YELLOW}make ci${OFF} to see it in full."
say "If you are certain this is fine, push again with ${YELLOW}--no-verify${OFF}."
say ""
exit 1

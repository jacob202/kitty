#!/bin/sh
# Kitty pre-commit hook.
# Invoked by scripts/hooks/pre-commit after `make hooks`; do not copy it into .git/hooks.
# Edit this template in-repo so the tracked hook path stays authoritative.

# Coordination guard — a supported mutating worktree must hold exactly one
# live OWN/INTEGRATE claim covering every staged path before any expensive work.
COORD_OUT=$(./kitty agent guard --staged --json 2>&1)
COORD_EXIT=$?
echo "$COORD_OUT"
if [ $COORD_EXIT -ne 0 ]; then
  echo "Coordination claim check failed; acquire or repair the worktree claim before committing."
  exit $COORD_EXIT
fi

# macOS metadata guard — refuse commits containing Finder artifacts.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
JUNK=""
for f in $STAGED; do
  base=$(basename "$f")
  case "$base" in
    .DS_Store) JUNK="$JUNK $f" ;;
    ._'*') JUNK="$JUNK $f" ;;
    Icon*) JUNK="$JUNK $f" ;;
  esac
done
if [ -n "$JUNK" ]; then
  echo "macOS metadata in staged files:$JUNK"
  echo "Unstage them: git reset HEAD -- <files>"
  exit 1
fi

echo "Running pre-commit tests..."
TEST_OUT=$(/opt/homebrew/bin/python3.12 -m pytest tests/ -q --tb=short 2>&1)
TEST_EXIT=$?
echo "$TEST_OUT"

SUMMARY=$(echo "$TEST_OUT" | grep -E "passed|failed|error" | tail -1)
mkdir -p "$(git rev-parse --show-toplevel)/data"
printf '{"summary":"%s"}\n' "$SUMMARY" > "$(git rev-parse --show-toplevel)/data/test-status.json"

if [ $TEST_EXIT -ne 0 ]; then
  echo "Tests failed! Aborting commit."
  echo "Please fix the failing tests before committing."
  exit 1
fi

echo "Tests passed!"

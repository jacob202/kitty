{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npx tsc --noEmit)",
      "Bash(git fetch *)",
      "Bash(python3* -m pytest*)",
      "Bash(uv *)",
      "Bash(gh *)",
      "Bash(cat ~/.claude/*)"
    ],
    "deny": [
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)",
      "Bash(npm publish*)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scan-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-commands.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scan-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-large-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/build-it-hook.sh evidence-lint.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/format-edited.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/recall-thread.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/build-it-hook.sh --check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-stop.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/build-it-hook.sh turn-end-gate.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "build-it@build-it": true,
    "fable-mode@fable-mode": true
  },
  "extraKnownMarketplaces": {
    "build-it": {
      "source": {
        "source": "github",
        "repo": "DevOtts/build-it"
      }
    },
    "fable-mode": {
      "source": {
        "source": "github",
        "repo": "fabdelgado/fable-mode"
      }
    }
  },
  "sessionStart": "python3.11 -m pytest tests/ -q --tb=line 2>/dev/null | tail -1 || true",
  "autoSave": true,
  "terminalIntegration": true
}

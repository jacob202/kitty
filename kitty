#!/usr/bin/env bash
# Kitty launcher — one command to run, stop, and inspect the stack.
#
# Usage:
#   kitty           Start gateway + LiteLLM + UI and open the browser (default)
#   kitty up        Start gateway + LiteLLM (background, logs to logs/)
#   kitty down      Stop both
#   kitty status    Show what's running + health check
#   kitty doctor    Full preflight check (gateway/doctor.py)
#   kitty health    Quick health check — is everything running?
#   kitty context --agent  Print deterministic repository continuity JSON
#   kitty logs      Tail live logs for both services
#   kitty backup    Back up app-owned data under data/backups/kitty/
#   kitty restore-drill BACKUP_DIR RESTORE_DIR
#   kitty restore BACKUP_DIR [--target-dir DIR] [--replace]
#   kitty install   Install launchd plists so the stack auto-starts on reboot
#   kitty uninstall Remove launchd plists
#   kitty run-fg    Run gateway in foreground (for debugging)
#   kitty resume    Print one-screen orientation block (branch, PRs, tests, services, packets)
#   kitty usage [--top N] [--sort KEY] [--json]  Rank Claude Code sessions by token spend
#   kitty builder <cmd>        Run Kitty Builder Layer 1A (brief, contract validate)
#   kitty room <cmd>           Read/post/reply/ack in the canonical global agent room
#   kitty agent <cmd>          Claim/renew/release/status/guard shared mutation ownership
#   kitty governor explain <dispatch.json>  Dry-run: would this agent work run, defer, downgrade, or be rejected
#   kitty delegate <action-id>  Generate a docs/packets/NNN-slug.md file from an action
#   kitty tutor learn <path>     Ingest a doc into the Tutor (RAG learning)
#   kitty tutor ask "<q>"        Vocab-first answer + one check-in question
#   kitty tutor review           Show terms you struggled with, due now
#   kitty tutor rate "<term>" <1-3>  Log confidence (1 got it, 2 need example, 3 lost)
#   kitty push [--alert] "message"  Push to Jacob's phone (iMessage, Pushover fallback)
#   kitty project add "name" /abs/path [kind]   Register a project (kind: code|admin|creative|...)
#   kitty project list                          List registered projects
#   kitty project refresh <id>                  Recompose state + regenerate the next step ("B")
#   kitty project next <id>                     Show the current next step for a project
#   kitty project set-path <id> /abs/path       Fix a project's path
#   kitty verify-home   Start gateway+UI if needed, check health + tailnet, print the iPhone URL
#
# Environment: reads .env from the repo root if present. All overrides
# (GATEWAY_PORT, LITELLM_PORT, LITELLM_VENV, …) live in .env, never here.

set -euo pipefail

KITTY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export KITTY_ROOT

RUN_DIR="$KITTY_ROOT/logs/.run"
LOG_DIR="$KITTY_ROOT/logs"

# ── Load .env ────────────────────────────────────────────────────────────────
export PYTHON_BIN="${PYTHON_BIN:-$KITTY_ROOT/venv/bin/python}"
source "$KITTY_ROOT/gateway/lib/load_env_safe.sh"

if [[ -f "$KITTY_ROOT/.env" ]]; then
  load_env_assignments "$KITTY_ROOT/.env"
fi

GATEWAY_PORT="${GATEWAY_PORT:-8000}"
LITELLM_PORT="${LITELLM_PORT:-8001}"
LITELLM_MASTER_KEY="${LITELLM_MASTER_KEY:-kitty-local-key-change-me}"
UI_PORT="${UI_PORT:-4000}"

# ── Helpers ───────────────────────────────────────────────────────────────────
mkdir -p "$RUN_DIR" "$LOG_DIR"

pid_alive() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

launchd_plist_path() {
  local svc="$1"
  printf '%s\n' "$HOME/Library/LaunchAgents/com.kitty.desktop.$svc.plist"
}

launchd_configured() {
  local svc
  for svc in ui gateway litellm; do
    [[ -f "$(launchd_plist_path "$svc")" ]] && return 0
  done
  return 1
}

launchd_pid() {
  local svc="$1"
  launchctl print "gui/$(id -u)/com.kitty.desktop.$svc" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*pid = / { print $2; exit }'
}

http_ok() {
  local url="$1"; shift
  curl -sf --max-time 3 "$@" "$url" >/dev/null 2>&1
}

listener_pids() {
  local port="$1"
  lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
}

all_listener_pid_ports() {
  local line pid="" name port
  while IFS= read -r line; do
    case "$line" in
      p*) pid="${line#p}" ;;
      n*)
        name="${line#n}"
        port="${name##*:}"
        port="${port%%[!0-9]*}"
        if [[ -n "$pid" && "$port" =~ ^[0-9]+$ ]]; then
          printf '%s|%s\n' "$pid" "$port"
        fi
        ;;
    esac
  done < <(lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null || true) | sort -u
}

pid_command() {
  ps -p "$1" -o command= 2>/dev/null || true
}

pid_cwd() {
  lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
}

pid_owned_by_current_checkout() {
  local pid="$1" cwd
  cwd="$(pid_cwd "$pid")"
  [[ "$cwd" == "$KITTY_ROOT" || "$cwd" == "$KITTY_ROOT/"* ]]
}

pid_owned_by_kitty() {
  local pid="$1"
  local cwd git_dir_root git_dir_candidate
  cwd="$(pid_cwd "$pid")"

  # Fast path: process cwd is inside current KITTY_ROOT
  if [[ "$cwd" == "$KITTY_ROOT" || "$cwd" == "$KITTY_ROOT/"* ]]; then
    return 0
  fi

  # Cross-worktree check: does the process belong to the same Git repository?
  # Two worktrees of the same repo share a common .git directory; a process
  # started from either one is Kitty-owned.
  if [[ -n "$cwd" && -d "$cwd" ]]; then
    # --git-common-dir may be relative (from the git -C cwd). Resolve by
    # entering that cwd first, then the git-dir, then pwd -P.
    git_dir_root="$(cd "$KITTY_ROOT" 2>/dev/null \
      && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null \
      && pwd -P 2>/dev/null || true)"
    git_dir_candidate="$(cd "$cwd" 2>/dev/null \
      && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null \
      && pwd -P 2>/dev/null || true)"
    if [[ -n "$git_dir_root" && -n "$git_dir_candidate" && "$git_dir_root" == "$git_dir_candidate" ]]; then
      return 0
    fi
  fi

  return 1
}

pid_role() {
  local pid="$1"
  if pid_owned_by_current_checkout "$pid"; then
    echo "owned-current"
  elif pid_owned_by_kitty "$pid"; then
    echo "owned-other-worktree"
  else
    echo "external"
  fi
}

runtime_source_sha() {
  local sha dirty
  sha="$(git -C "$KITTY_ROOT" rev-parse HEAD 2>/dev/null || true)"
  [[ -n "$sha" ]] || return 1
  dirty="$(git -C "$KITTY_ROOT" status --porcelain --untracked-files=normal 2>/dev/null || true)"
  [[ -z "$dirty" ]] || sha="dirty:$sha"
  printf '%s\n' "$sha"
}

record_runtime_identity() {
  local svc="$1" pid="$2" source_sha="$3"
  [[ -n "$svc" && -n "$pid" && -n "$source_sha" ]] || return 1
  printf '%s|%s|%s\n' "$pid" "$KITTY_ROOT" "$source_sha" > "$RUN_DIR/$svc.identity"
}

pid_worktree_identity() {
  # The identity file must belong to the service actually being asked about.
  # Accepting any service's file with a matching PID lets a stale record left
  # by an unclean shutdown be reused by an unrelated listener that recycled
  # that PID, which reports provenance for a process that never wrote it.
  local pid="$1" svc="$2" cwd line recorded_pid root sha process_root identity_file
  [[ -n "$pid" && -n "$svc" ]] || return 1
  pid_owned_by_kitty "$pid" || return 1
  cwd="$(pid_cwd "$pid")"
  [[ -n "$cwd" ]] || return 1
  process_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$process_root" ]] || return 1
  identity_file="$process_root/logs/.run/$svc.identity"
  # No startup record means the listener predates this provenance mechanism or
  # was started externally. Never substitute the checkout's mutable current HEAD.
  [[ -f "$identity_file" ]] || return 1
  line="$(cat "$identity_file" 2>/dev/null || true)"
  IFS='|' read -r recorded_pid root sha <<< "$line"
  [[ "$recorded_pid" == "$pid" && -n "$root" && -n "$sha" ]] || return 1
  [[ "$cwd" == "$root" || "$cwd" == "$root/"* ]] || return 1
  printf '%s@%s\n' "$root" "$sha"
}

classify_primary_stack() {
  local ui_identity="${1:-}" gateway_identity="${2:-}"
  if [[ -z "$ui_identity" && -z "$gateway_identity" ]]; then
    echo "stopped"
  elif [[ -z "$ui_identity" || -z "$gateway_identity" ]]; then
    echo "partial"
  elif [[ "$ui_identity" == "$gateway_identity" ]]; then
    echo "coherent"
  else
    echo "split"
  fi
}

stop_pidfile() {
  local svc="$1"
  local pidfile="$RUN_DIR/$svc.pid"
  if pid_alive "$pidfile"; then
    local pid
    pid="$(cat "$pidfile")"
    if pid_owned_by_current_checkout "$pid"; then
      pkill -TERM -P "$pid" 2>/dev/null || true
      kill -TERM "$pid" 2>/dev/null || true
      echo "  $svc  stopping (pid $pid)"
    else
      echo "  $svc  pidfile points at $(pid_role "$pid") pid $pid; leaving process alone"
    fi
  fi
  rm -f "$pidfile"
}

assert_port_available() {
  local label="$1" port="$2" pids pid cwd
  pids="$(listener_pids "$port")"
  if [[ -n "$pids" ]]; then
    for pid in $pids; do
      if pid_owned_by_kitty "$pid"; then
        cwd="$(pid_cwd "$pid")"
        if [[ "$cwd" == "$KITTY_ROOT" || "$cwd" == "$KITTY_ROOT/"* ]]; then
          echo "Error: $label port :$port is held by a leftover Kitty process from this checkout" >&2
          echo "  pid $pid: $(pid_command "$pid")" >&2
          echo "  Run './kitty down' to clean up." >&2
        else
          echo "Error: $label port :$port is held by another Kitty worktree" >&2
          echo "  pid $pid: $(pid_command "$pid")" >&2
          echo "  worktree: ${cwd:-unknown}" >&2
          echo "  Stop it with: (cd \"$cwd\" && ./kitty down)" >&2
        fi
        return 1
      fi
    done
    echo "Error: $label port :$port is already owned by pid(s): $pids" >&2
    for pid in $pids; do
      echo "  pid $pid: $(pid_command "$pid")" >&2
    done
    echo "Run './kitty down' to stop Kitty-owned listeners; unrelated listeners are never killed." >&2
    return 1
  fi
}

generate_secret() {
  local python="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python" ]]; then
    python="$(command -v python3)"
  fi
  "$python" - <<'PY'
import secrets
print(secrets.token_urlsafe(32))
PY
}

append_env_secret() {
  local key="$1"
  local value="$2"
  local env_file="$KITTY_ROOT/.env"

  if [[ ! -f "$env_file" ]]; then
    umask 077
    : > "$env_file"
  fi

  # Replace, never append. ensure_gateway_secret tests the shell environment
  # rather than the file, so from a shell that had not sourced .env this used to
  # add a second GATEWAY_SECRET with a different value. Readers that take the
  # first match (grep | head -1, and some dotenv loaders) then authenticated
  # with a secret the gateway rejects — a 401 with nothing obviously wrong.
  local tmp
  tmp="$(mktemp "${env_file}.XXXXXX")" || return 1
  chmod 600 "$tmp"
  awk -v key="$key" '
    $0 == "# Generated by ./kitty for local gateway auth" { pending = $0; next }
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "=" { pending = ""; next }
    { if (pending != "") { print pending; pending = "" } print }
    END { if (pending != "") print pending }
  ' "$env_file" > "$tmp"
  {
    echo
    echo "# Generated by ./kitty for local gateway auth"
    echo "$key=$value"
  } >> "$tmp"
  mv "$tmp" "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true
}

ensure_gateway_secret() {
  local secret="${GATEWAY_SECRET:-${KITTY_GATEWAY_SECRET:-}}"
  local generated=0

  if [[ -z "$secret" ]]; then
    secret="$(generate_secret)"
    generated=1
  fi

  if [[ -z "${GATEWAY_SECRET:-}" ]]; then
    append_env_secret "GATEWAY_SECRET" "$secret"
    export GATEWAY_SECRET="$secret"
  fi

  if [[ -z "${KITTY_GATEWAY_SECRET:-}" ]]; then
    append_env_secret "KITTY_GATEWAY_SECRET" "$secret"
    export KITTY_GATEWAY_SECRET="$secret"
  fi

  if [[ "$generated" == "1" ]]; then
    echo "  Generated local gateway secret in .env"
  fi
}

# ── ANSI color codes ──────────────────────────────────────────────────────────
GREEN=[92m
RED=[91m
YELLOW=[93m
RESET=[0m

# ── Subcommands ───────────────────────────────────────────────────────────────

expand_user_path() {
  local value="$1"
  case "$value" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${value:2}" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

normalize_user_path() {
  local value python_bin
  value="$(expand_user_path "$1")"
  if [[ "$value" != /* ]]; then
    value="$(pwd -P)/$value"
  fi
  # Path normalization is launcher plumbing, not an application-runtime call.
  # Do not use PYTHON_BIN here: tests and operator wrappers may intentionally
  # point PYTHON_BIN at a service shim with different behavior.
  python_bin="$(command -v python3 || true)"
  if [[ -n "$python_bin" ]]; then
    "$python_bin" -c 'import os,sys; print(os.path.normpath(sys.argv[1]))' "$value"
  else
    printf '%s\n' "$value"
  fi
}

selected_data_root() {
  if [[ -n "${KITTY_DATA_ROOT:-}" ]]; then
    normalize_user_path "$KITTY_DATA_ROOT"
    return
  fi
  local git_common_dir canonical_root
  git_common_dir="$(git -C "$KITTY_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  canonical_root="$KITTY_ROOT"
  if [[ -n "$git_common_dir" ]]; then
    canonical_root="$(dirname "$git_common_dir")"
  fi
  printf '%s/data\n' "$canonical_root"
}

ensure_agent_room_data_root() {
  # Agent Room needs the canonical personal data root, but it must not care
  # whether Builder or compute-governor overrides are intentionally isolated.
  local data_root
  data_root="$(selected_data_root)"
  export KITTY_DATA_ROOT="${data_root%/}"
}

ensure_runtime_builder_data_dir() {
  # Normal Kitty runtimes select ONE coherent personal workspace: app data,
  # Builder, and the compute governor all derive from the same data root, so
  # they can never silently split across checkouts (the exact bug that
  # produced this convergence work). KITTY_DATA_ROOT explicit override always
  # wins — that's how tests/sandboxes keep isolation. Otherwise the root is
  # the canonical Git common directory's parent, never the invoking worktree's
  # own root, so a secondary worktree still finds Jacob's real history. A
  # Builder or compute-governor override that contradicts the selected root
  # is refused rather than silently splitting state across two workspaces.
  local data_root explicit_data_root=0
  [[ -n "${KITTY_DATA_ROOT:-}" ]] && explicit_data_root=1
  data_root="$(selected_data_root)"
  data_root="${data_root%/}"

  local expected_builder_dir="${data_root}/kittybuilder"
  local expected_governor_db="${data_root}/compute_governor/receipts.db"
  local builder_override governor_override
  builder_override=""
  governor_override=""
  [[ -z "${KITTY_BUILDER_DATA_DIR:-}" ]] || builder_override="$(normalize_user_path "$KITTY_BUILDER_DATA_DIR")"
  [[ -z "${KITTY_COMPUTE_GOVERNOR_DB:-}" ]] || governor_override="$(normalize_user_path "$KITTY_COMPUTE_GOVERNOR_DB")"

  if [[ -n "$builder_override" && "${builder_override%/}" != "$expected_builder_dir" ]]; then
    echo "Error: KITTY_BUILDER_DATA_DIR conflicts with the selected personal data root." >&2
    echo "  data root:              $data_root" >&2
    echo "  KITTY_BUILDER_DATA_DIR: $KITTY_BUILDER_DATA_DIR" >&2
    echo "  expected:               $expected_builder_dir" >&2
    echo "  Set KITTY_DATA_ROOT to the workspace you mean, or unset KITTY_BUILDER_DATA_DIR — Kitty will not split Builder state from app data." >&2
    return 1
  fi
  if [[ -n "$governor_override" && "$governor_override" != "$expected_governor_db" ]]; then
    echo "Error: KITTY_COMPUTE_GOVERNOR_DB conflicts with the selected personal data root." >&2
    echo "  data root:                $data_root" >&2
    echo "  KITTY_COMPUTE_GOVERNOR_DB: $KITTY_COMPUTE_GOVERNOR_DB" >&2
    echo "  expected:                 $expected_governor_db" >&2
    echo "  Set KITTY_DATA_ROOT to the workspace you mean, or unset KITTY_COMPUTE_GOVERNOR_DB — Kitty will not split compute-governor state from app data." >&2
    return 1
  fi

  export KITTY_DATA_ROOT="$data_root"
  export KITTY_BUILDER_DATA_DIR="$expected_builder_dir"
  export KITTY_COMPUTE_GOVERNOR_DB="$expected_governor_db"
  export KITTY_DATA_ROOT_EXPLICIT="$explicit_data_root"
}

require_existing_personal_workspace() {
  # Never silently start a fresh empty personal workspace. If the selected
  # data root does not already exist, something resolved wrong (wrong
  # checkout, an override pointing nowhere) — fail loudly instead of quietly
  # starting clean, which is how Jacob would lose his history without being
  # told.
  if [[ ! -d "$KITTY_DATA_ROOT" ]]; then
    echo "Error: the selected personal data root does not exist: $KITTY_DATA_ROOT" >&2
    echo "  Kitty will not silently start a fresh empty workspace in its place." >&2
    echo "  For an intentional first run or sandbox, set KITTY_DATA_ROOT explicitly and create that directory first." >&2
    echo "  Otherwise this checkout is not resolving to the workspace you expect." >&2
    return 1
  fi

  # An explicit KITTY_DATA_ROOT is the operator's opt-in path for a new/sandbox
  # workspace. The implicit canonical default, however, must contain real Kitty
  # state; tracked data/.gitkeep alone is not evidence of a personal workspace.
  if [[ "${KITTY_DATA_ROOT_EXPLICIT:-0}" != "1" && ! -e "$KITTY_DATA_ROOT/kitty/kitty.db" ]]; then
    echo "Error: the implicit personal data root has no established Kitty state: $KITTY_DATA_ROOT" >&2
    echo "  The canonical personal database kitty/kitty.db is missing; ancillary Builder or governor state is not enough." >&2
    echo "  For an intentional first run or sandbox, set KITTY_DATA_ROOT explicitly." >&2
    return 1
  fi
}

startup_identity() {
  local label="$1" port="$2" pid="$3"
  local sha build_id
  sha="$(git -C "$KITTY_ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")"
  build_id=""
  if [[ -f "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID" ]]; then
    build_id="$(cat "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID")"
  fi
  printf "  %-10s pid=%-6s port=%-5s checkout=%s sha=%s build=%s\n" \
    "$label" "$pid" "$port" "$KITTY_ROOT" "$sha" "${build_id:-none}"
}

cmd_up() {
  local success=0
  echo ""
  echo "  ⚡ Starting Kitty..."
  echo ""
  startup_identity "kitty" "-" "$$"
  ensure_runtime_builder_data_dir
  require_existing_personal_workspace
  ensure_gateway_secret

  # LiteLLM
  if pid_alive "$RUN_DIR/litellm.pid"; then
    echo "  ✓ LiteLLM   already running"
  else
    assert_port_available "LiteLLM" "$LITELLM_PORT" || return 1
    printf "  ⏳ LiteLLM   starting... "
    nohup bash "$KITTY_ROOT/gateway/start_litellm.sh" \
      >"$LOG_DIR/litellm.log" 2>&1 &
    echo $! >"$RUN_DIR/litellm.pid"
    startup_identity "LiteLLM" "$LITELLM_PORT" "$!" >/dev/null
    _i=0
    while [ $_i -lt 10 ]; do
      if http_ok "http://127.0.0.1:$LITELLM_PORT/health/readiness" \
           -H "Authorization: Bearer $LITELLM_MASTER_KEY" 2>/dev/null; then
        echo "✓"
        break
      fi
      printf "."
      sleep 1
      _i=$((_i + 1))
    done
    if [ $_i -ge 10 ]; then
      echo "✗"
      echo "  ⚠ LiteLLM   not responding — check: kitty logs"
    fi
  fi

  # Gateway
  if pid_alive "$RUN_DIR/gateway.pid"; then
    echo "  ✓ Gateway    already running"
  else
    assert_port_available "Gateway" "$GATEWAY_PORT" || return 1
    printf "  ⏳ Gateway    starting... "
    local gateway_source_sha gateway_pid
    gateway_source_sha="$(runtime_source_sha || echo unknown)"
    nohup bash "$KITTY_ROOT/gateway/start_gateway.sh" \
      >"$LOG_DIR/gateway.log" 2>&1 &
    gateway_pid=$!
    echo "$gateway_pid" >"$RUN_DIR/gateway.pid"
    record_runtime_identity gateway "$gateway_pid" "$gateway_source_sha"
    startup_identity "Gateway" "$GATEWAY_PORT" "$gateway_pid" >/dev/null
    _i=0
    while [ $_i -lt 15 ]; do
      if http_ok "http://127.0.0.1:$GATEWAY_PORT/health"; then
        echo "✓"
        break
      fi
      printf "."
      sleep 1
      _i=$((_i + 1))
    done
    if [ $_i -ge 15 ]; then
      echo "✗"
      echo "  ⚠ Gateway    not responding — check: kitty logs"
    else
      success=1
    fi
  fi

  echo ""
  if [ "$success" -eq 1 ] || pid_alive "$RUN_DIR/gateway.pid"; then
    local litellm_status="?"
    if http_ok "http://127.0.0.1:$LITELLM_PORT/health/readiness" \
         -H "Authorization: Bearer $LITELLM_MASTER_KEY" 2>/dev/null; then
      litellm_status="✓"
    else
      litellm_status="✗"
    fi
    echo "  ───────────────"
    echo "  Gateway   http://127.0.0.1:$GATEWAY_PORT  ✓"
    echo "  LiteLLM   http://127.0.0.1:$LITELLM_PORT  $litellm_status"
    echo "  UI        http://127.0.0.1:$UI_PORT"
    echo ""
    echo "  ✨ Kitty is running. Run 'kitty health' for a full check."
  else
    echo "  ❌ Kitty failed to start. Run 'kitty health' for details."
    return 1
  fi
}


# Start only the Next.js UI, leaving gateway and LiteLLM alone. `up`/`down`
# boot out the launchd jobs `install` created, so anything that just wants the
# UI back — rolling back off Open WebUI, most obviously — must not go through
# them. Returns non-zero when the UI does not come up.
cmd_ui() {
  if ! http_ok "http://127.0.0.1:$UI_PORT/"; then
    assert_port_available "UI" "$UI_PORT"
    echo "Starting UI on http://127.0.0.1:$UI_PORT ..."
    local ui_source_sha ui_pid
    ui_source_sha="$(runtime_source_sha || echo unknown)"
    KITTY_UI_PORT="$UI_PORT" \
      KITTY_GATEWAY_URL="http://127.0.0.1:$GATEWAY_PORT" \
      KITTY_UI_BIND_ALL=true \
      nohup bash "$KITTY_ROOT/scripts/desktop/start_ui.sh" \
        >"$LOG_DIR/ui.log" 2>&1 &
    ui_pid=$!
    echo "$ui_pid" >"$RUN_DIR/ui.pid"
    record_runtime_identity ui "$ui_pid" "$ui_source_sha"
    startup_identity "UI" "$UI_PORT" "$ui_pid"
    _i=0
    while [ $_i -lt 30 ]; do
      if http_ok "http://127.0.0.1:$UI_PORT/"; then break; fi
      sleep 1
      _i=$((_i + 1))
    done
  fi

  if http_ok "http://127.0.0.1:$UI_PORT/"; then
    echo "UI ready: http://127.0.0.1:$UI_PORT"
    return 0
  fi
  echo "UI not responding on :$UI_PORT — check: $LOG_DIR/ui.log" >&2
  return 1
}

cmd_start() {
  # One-shot launch: gateway + LiteLLM + UI, then open the browser.
  cmd_up

  if ! cmd_ui; then
    return 1
  fi
  if command -v open >/dev/null 2>&1; then
    open "http://127.0.0.1:$UI_PORT"
  fi
}

cmd_down() {
  echo "Stopping Kitty..."
  local svc launch_pid

  # Disable only launchd jobs whose live process is proven to belong to this
  # checkout. A sibling worktree's canonical service is an active ownership
  # domain, not something a different checkout may stop by label alone.
  for svc in ui gateway litellm; do
    launch_pid="$(launchd_pid "$svc" || true)"
    if [[ -n "$launch_pid" ]] && pid_owned_by_current_checkout "$launch_pid"; then
      launchctl bootout "gui/$(id -u)/com.kitty.desktop.$svc" 2>/dev/null || true
      echo "  $svc  launchd job stopped"
    elif [[ -n "$launch_pid" ]]; then
      echo "  leaving launchd $svc pid $launch_pid role=$(pid_role "$launch_pid")"
    fi
  done

  # Clean up only listeners that this checkout can prove it owns. Another Kitty
  # worktree may be an active implementation/acceptance lane, and an unrelated
  # process on the same port is never ours to terminate.
  for port in "$UI_PORT" "$GATEWAY_PORT" "$LITELLM_PORT"; do
    for pid in $(listener_pids "$port"); do
      if pid_owned_by_current_checkout "$pid"; then
        echo "  stopping listener pid $pid on :$port ($(pid_command "$pid" | cut -c1-80))"
        kill -KILL "$pid" 2>/dev/null || true
      else
        echo "  leaving unrelated listener pid $pid on :$port role=$(pid_role "$pid") cwd=$(pid_cwd "$pid")"
      fi
    done
  done
  sleep 1

  for svc in ui gateway litellm; do
    stop_pidfile "$svc"
  done

  rm -f "$RUN_DIR/ui.pid" "$RUN_DIR/gateway.pid" "$RUN_DIR/litellm.pid" \
    "$RUN_DIR/ui.identity" "$RUN_DIR/gateway.identity" "$RUN_DIR/litellm.identity"
}

cmd_status_quick() {
  local fails=0
  local ui_port="${UI_PORT:-4000}"

  if http_ok "http://127.0.0.1:$GATEWAY_PORT/health"; then
    local litellm_status="${GREEN}OK${RESET}"
    if curl -sf --max-time 3 "http://127.0.0.1:$GATEWAY_PORT/health" 2>/dev/null | grep -q '"litellm_reachable": *true'; then
      litellm_status="${GREEN}OK${RESET}"
    else
      litellm_status="${RED}FAIL${RESET}"
    fi
    printf "  %b Gateway  %b\n" "${GREEN}\xE2\x9C\x93${RESET}" "$litellm_status"
  else
    printf "  %b Gateway  %b\n" "${RED}\xE2\x9C\x97${RESET}" "${RED}FAIL${RESET}"
    fails=1
  fi

  if http_ok "http://127.0.0.1:$LITELLM_PORT/health/readiness" -H "Authorization: Bearer $LITELLM_MASTER_KEY" 2>/dev/null; then
    printf "  %b LiteLLM  %b\n" "${GREEN}\xE2\x9C\x93${RESET}" "${GREEN}OK${RESET}"
  else
    printf "  %b LiteLLM  %b\n" "${RED}\xE2\x9C\x97${RESET}" "${RED}FAIL${RESET}"
  fi

  if http_ok "http://127.0.0.1:$ui_port/"; then
    printf "  %b UI       %b\n" "${GREEN}\xE2\x9C\x93${RESET}" "${GREEN}OK${RESET}"
  else
    printf "  %b UI       %b\n" "${RED}\xE2\x9C\x97${RESET}" "${RED}FAIL${RESET}"
    fails=1
  fi

  local data_dir="$KITTY_ROOT/data"
  if [[ -d "$data_dir" ]]; then
    printf "  %b Data     %b\n" "${GREEN}\xE2\x9C\x93${RESET}" "${GREEN}OK${RESET}"
  else
    printf "  %b Data     %b\n" "${YELLOW}\xE2\x9A\xA0${RESET}" "${YELLOW}WARN${RESET}"
  fi

  return "$fails"
}

cmd_status() {
  if [[ "${1:-}" == "--quick" ]]; then
    cmd_status_quick
    return $?
  fi
  local sha authority_sha authority_relation dirty_state branch build_id build_source supervisor_mode svc_probe
  local runtime_probe runtime_python ui_build_state gateway_probe_level gateway_probe_detail
  sha="$(git -C "$KITTY_ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")"
  branch="$(git -C "$KITTY_ROOT" branch --show-current 2>/dev/null || true)"
  authority_sha="$(git -C "$KITTY_ROOT" rev-parse refs/remotes/origin/main 2>/dev/null || echo "unknown")"
  authority_relation="unknown"
  if [[ "$sha" != "unknown" && "$authority_sha" != "unknown" ]]; then
    if [[ "$sha" == "$authority_sha" ]]; then
      authority_relation="current"
    elif git -C "$KITTY_ROOT" merge-base --is-ancestor "$sha" "$authority_sha" 2>/dev/null; then
      authority_relation="behind"
    elif git -C "$KITTY_ROOT" merge-base --is-ancestor "$authority_sha" "$sha" 2>/dev/null; then
      authority_relation="ahead"
    else
      authority_relation="diverged"
    fi
  fi
  dirty_state="clean"
  [[ -n "$(git -C "$KITTY_ROOT" status --porcelain 2>/dev/null)" ]] && dirty_state="dirty"
  build_id="unknown"
  build_source="unknown"
  runtime_python="$PYTHON_BIN"
  if [[ ! -x "$runtime_python" ]]; then
    runtime_python="$(command -v python3 || true)"
  fi
  runtime_probe="$(
    "$runtime_python" -c 'from gateway.doctor import runtime_provenance_status_line; print(runtime_provenance_status_line())' \
      2>/dev/null || true
  )"
  ui_build_state="unknown"
  gateway_probe_level="WARN"
  gateway_probe_detail="runtime provenance probe unavailable"
  if [[ -n "$runtime_probe" ]]; then
    IFS='|' read -r build_id ui_build_state build_source gateway_probe_level gateway_probe_detail <<< "$runtime_probe"
  fi
  supervisor_mode="manual"
  if launchd_configured; then
    supervisor_mode="launchd-configured-stopped"
  fi
  for svc_probe in ui gateway litellm; do
    if [[ -n "$(launchd_pid "$svc_probe" || true)" ]]; then
      supervisor_mode="launchd-active"
      break
    fi
  done

  echo "Kitty status"
  echo "────────────"
  echo "  checkout     $KITTY_ROOT"
  echo "  branch       ${branch:-detached}"
  echo "  source sha   $sha"
  echo "  authority    origin/main $authority_sha ($authority_relation)"
  echo "  working tree $dirty_state"
  echo "  supervisor   $supervisor_mode (com.kitty.desktop.*)"
  echo "  build id     ${build_id:-none}"
  echo "  build source ${build_source:-unknown}"
  echo "  build freshness ${ui_build_state:-unknown}"
  echo "  gateway truth ${gateway_probe_level:-WARN}: ${gateway_probe_detail:-runtime provenance probe unavailable}"

  echo
  local svc pidfile pid pidfile_pid launch_pid port found_pid cwd role
  for svc in ui gateway litellm; do
    case "$svc" in
      ui) port="$UI_PORT" ;;
      gateway) port="$GATEWAY_PORT" ;;
      litellm) port="$LITELLM_PORT" ;;
    esac
    pidfile="$RUN_DIR/$svc.pid"
    found_pid="$(listener_pids "$port" | head -1)"
    if [[ -n "$found_pid" ]]; then
      role="$(pid_role "$found_pid")"
      cwd="$(pid_cwd "$found_pid")"
      printf "  %-10s running (pid %s; listener :%s; role=%s; cwd=%s)\n" \
        "$svc" "$found_pid" "$port" "$role" "${cwd:-unknown}"
      if pid_alive "$pidfile"; then
        pidfile_pid="$(cat "$pidfile")"
        if [[ "$pidfile_pid" != "$found_pid" ]]; then
          printf "             metadata mismatch: pidfile=%s does not own :%s\n" "$pidfile_pid" "$port"
        fi
      fi
    elif pid_alive "$pidfile"; then
      pid="$(cat "$pidfile")"
      role="$(pid_role "$pid")"
      cwd="$(pid_cwd "$pid")"
      printf "  %-10s process alive but not listening on :%s (pid %s; role=%s; cwd=%s)\n" \
        "$svc" "$port" "$pid" "$role" "${cwd:-unknown}"
    elif launch_pid="$(launchd_pid "$svc")" && [[ -n "$launch_pid" ]]; then
      role="$(pid_role "$launch_pid")"
      cwd="$(pid_cwd "$launch_pid")"
      printf "  %-10s launchd process alive but not listening on :%s (pid %s; role=%s; cwd=%s)\n" \
        "$svc" "$port" "$launch_pid" "$role" "${cwd:-unknown}"
    else
      printf "  %-10s not running\n" "$svc"
    fi
  done

  local ui_pid gateway_pid ui_identity gateway_identity stack_state current_identity
  ui_pid="$(listener_pids "$UI_PORT" | head -1)"
  gateway_pid="$(listener_pids "$GATEWAY_PORT" | head -1)"
  ui_identity=""
  gateway_identity=""
  [[ -n "$ui_pid" ]] && ui_identity="$(pid_worktree_identity "$ui_pid" ui || true)"
  [[ -n "$gateway_pid" ]] && gateway_identity="$(pid_worktree_identity "$gateway_pid" gateway || true)"
  stack_state="$(classify_primary_stack "$ui_identity" "$gateway_identity")"
  local current_source_sha
  current_source_sha="$(runtime_source_sha || echo "$sha")"
  current_identity="$KITTY_ROOT@$current_source_sha"

  echo
  echo "Product runtime"
  echo "───────────────"
  echo "  stack       $stack_state"
  if [[ -n "$ui_identity" ]]; then
    echo "  UI          $ui_identity"
  elif [[ -n "$ui_pid" ]]; then
    echo "  UI          external/unknown (pid $ui_pid)"
  else
    echo "  UI          not listening"
  fi
  if [[ -n "$gateway_identity" ]]; then
    echo "  Gateway     $gateway_identity"
  elif [[ -n "$gateway_pid" ]]; then
    echo "  Gateway     external/unknown (pid $gateway_pid)"
  else
    echo "  Gateway     not listening"
  fi
  if [[ "$stack_state" == "coherent" && "$ui_identity" == "$current_identity" ]]; then
    echo "  checkout    serving this exact checkout/source"
  elif [[ "$stack_state" == "coherent" ]]; then
    echo "  checkout    serving a different checkout/source"
  else
    echo "  checkout    no single worktree-bound serving source"
  fi

  # Read-only report of the same selection ensure_runtime_builder_data_dir
  # would make. Never fails or mutates env here — status must still print
  # when the workspace is misconfigured, so an operator can see why.
  local ws_data_root ws_builder_dir ws_governor_db ws_conflict=""
  local ws_builder_override="" ws_governor_override=""
  ws_data_root="$(selected_data_root)"
  ws_data_root="${ws_data_root%/}"
  ws_builder_dir="${ws_data_root}/kittybuilder"
  ws_governor_db="${ws_data_root}/compute_governor/receipts.db"
  [[ -z "${KITTY_BUILDER_DATA_DIR:-}" ]] || ws_builder_override="$(normalize_user_path "$KITTY_BUILDER_DATA_DIR")"
  [[ -z "${KITTY_COMPUTE_GOVERNOR_DB:-}" ]] || ws_governor_override="$(normalize_user_path "$KITTY_COMPUTE_GOVERNOR_DB")"
  if [[ -n "$ws_builder_override" && "${ws_builder_override%/}" != "$ws_builder_dir" ]]; then
    ws_conflict="KITTY_BUILDER_DATA_DIR=$KITTY_BUILDER_DATA_DIR conflicts with expected $ws_builder_dir"
  fi
  if [[ -n "$ws_governor_override" && "$ws_governor_override" != "$ws_governor_db" ]]; then
    [[ -n "$ws_conflict" ]] && ws_conflict="$ws_conflict; "
    ws_conflict="${ws_conflict}KITTY_COMPUTE_GOVERNOR_DB=$KITTY_COMPUTE_GOVERNOR_DB conflicts with expected $ws_governor_db"
  fi

  echo
  echo "Personal workspace"
  echo "───────────────────"
  if [[ -d "$ws_data_root" ]]; then
    echo "  data root     $ws_data_root"
  else
    echo "  data root     $ws_data_root  (missing)"
  fi
  echo "  builder root  $ws_builder_dir"
  echo "  compute root  $ws_governor_db"
  if [[ -n "$ws_conflict" ]]; then
    echo "  conflict      $ws_conflict"
  fi

  echo
  echo "Health checks"
  echo "─────────────"

  if http_ok "http://127.0.0.1:$GATEWAY_PORT/health"; then
    echo "  gateway   http://127.0.0.1:$GATEWAY_PORT  ✓"
  else
    echo "  gateway   http://127.0.0.1:$GATEWAY_PORT  ✗  (not responding)"
  fi

  if http_ok "http://127.0.0.1:$LITELLM_PORT/health/readiness" \
       -H "Authorization: Bearer $LITELLM_MASTER_KEY"; then
    echo "  litellm   http://127.0.0.1:$LITELLM_PORT  ✓"
  else
    echo "  litellm   http://127.0.0.1:$LITELLM_PORT  ✗  (not responding)"
  fi

  echo
  echo "Listeners"
  echo "─────────"
  local spec label pids
  for spec in "UI:$UI_PORT" "Gateway:$GATEWAY_PORT" "LiteLLM:$LITELLM_PORT"; do
    label="${spec%%:*}"
    port="${spec##*:}"
    pids="$(listener_pids "$port")"
    if [[ -n "$pids" ]]; then
      for pid in $pids; do
        printf "  %-10s :%s pid=%s role=%s cwd=%s\n" "$label" "$port" "$pid" "$(pid_role "$pid")" "$(pid_cwd "$pid")"
      done
    else
      printf "  %-10s :%s free\n" "$label" "$port"
    fi
  done

  echo
  echo "Other Kitty listeners"
  echo "─────────────────────"
  local listener_port other_count=0
  while IFS='|' read -r pid listener_port; do
    [[ -n "$pid" && -n "$listener_port" ]] || continue
    case "$listener_port" in
      "$UI_PORT"|"$GATEWAY_PORT"|"$LITELLM_PORT") continue ;;
    esac
    if pid_owned_by_kitty "$pid"; then
      printf "  :%-8s pid=%s role=%s cwd=%s\n" "$listener_port" "$pid" "$(pid_role "$pid")" "$(pid_cwd "$pid")"
      other_count=$((other_count + 1))
    fi
  done < <(all_listener_pid_ports)
  if [[ "$other_count" -eq 0 ]]; then
    echo "  none"
  fi
}


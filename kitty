#!/usr/bin/env bash
# Kitty launcher — one command to run, stop, and inspect the stack.
#
# Usage:
#   kitty           Start gateway + LiteLLM + UI and open the browser (default)
#   kitty up        Start gateway + LiteLLM (background, logs to logs/)
#   kitty down      Stop both
#   kitty status    Show what's running + health check
#   kitty doctor    Full preflight check (gateway/doctor.py)
#   kitty context --agent  Print deterministic repository continuity JSON
#   kitty logs      Tail live logs for both services
#   kitty backup    Back up app-owned data under data/backups/kitty/
#   kitty restore-drill BACKUP_DIR RESTORE_DIR
#   kitty install   Install launchd plists so the stack auto-starts on reboot
#   kitty uninstall Remove launchd plists
#   kitty run-fg    Run gateway in foreground (for debugging)
#   kitty resume    Print one-screen orientation block (branch, PRs, tests, services, packets)
#   kitty usage [--top N] [--sort KEY] [--json]  Rank Claude Code sessions by token spend
#   kitty builder <cmd>        Run Kitty Builder Layer 1A (brief, contract validate)
#   kitty governor explain <dispatch.json>  Dry-run: would this agent work run, defer, downgrade, or be rejected
#   kitty delegate <action-id>  Generate a docs/packets/NNN-slug.md file from an action
#   kitty tutor learn <path>     Ingest a doc into the Tutor (RAG learning)
#   kitty tutor ask "<q>"        Vocab-first answer + one check-in question
#   kitty tutor review           Show terms you struggled with, due now
#   kitty tutor rate "<term>" <1-3>  Log confidence (1 got it, 2 need example, 3 lost)
#   kitty push [--alert] "message"  Push to Jacob's phone (iMessage, Pushover fallback)
#   kitty project add "name" /abs/path [kind]   Register a project (kind: code|admin|creative|...)
#   kitty project list                          List registered projects
#   kitty project refresh <id>                  Recompose state + regenerate the next step ("B")
#   kitty project next <id>                     Show the current next step for a project
#   kitty project set-path <id> /abs/path       Fix a project's path
#   kitty verify-home   Start gateway+UI if needed, check health + tailnet, print the iPhone URL
#
# Environment: reads .env from the repo root if present. All overrides
# (GATEWAY_PORT, LITELLM_PORT, LITELLM_VENV, …) live in .env, never here.

set -euo pipefail

KITTY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export KITTY_ROOT

RUN_DIR="$KITTY_ROOT/logs/.run"
LOG_DIR="$KITTY_ROOT/logs"

# ── Load .env ────────────────────────────────────────────────────────────────
export PYTHON_BIN="${PYTHON_BIN:-$KITTY_ROOT/venv/bin/python}"
source "$KITTY_ROOT/gateway/lib/load_env_safe.sh"

if [[ -f "$KITTY_ROOT/.env" ]]; then
  load_env_assignments "$KITTY_ROOT/.env"
fi

GATEWAY_PORT="${GATEWAY_PORT:-8000}"
LITELLM_PORT="${LITELLM_PORT:-8001}"
LITELLM_MASTER_KEY="${LITELLM_MASTER_KEY:-kitty-local-key-change-me}"
UI_PORT="${UI_PORT:-4000}"

# ── Helpers ───────────────────────────────────────────────────────────────────
mkdir -p "$RUN_DIR" "$LOG_DIR"

pid_alive() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

launchd_pid() {
  local svc="$1"
  launchctl print "gui/$(id -u)/com.kitty.$svc" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*pid = / { print $2; exit }'
}

http_ok() {
  local url="$1"; shift
  curl -sf --max-time 3 "$@" "$url" >/dev/null 2>&1
}

listener_pids() {
  local port="$1"
  lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
}

pid_command() {
  ps -p "$1" -o command= 2>/dev/null || true
}

pid_cwd() {
  lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
}

pid_owned_by_kitty() {
  local pid="$1"
  local cwd git_dir_root git_dir_candidate
  cwd="$(pid_cwd "$pid")"

  # Fast path: process cwd is inside current KITTY_ROOT
  if [[ "$cwd" == "$KITTY_ROOT" || "$cwd" == "$KITTY_ROOT/"* ]]; then
    return 0
  fi

  # Cross-worktree check: does the process belong to the same Git repository?
  # Two worktrees of the same repo share a common .git directory; a process
  # started from either one is Kitty-owned.
  if [[ -n "$cwd" && -d "$cwd" ]]; then
    # --git-common-dir may be relative (from the git -C cwd). Resolve by
    # entering that cwd first, then the git-dir, then pwd -P.
    git_dir_root="$(cd "$KITTY_ROOT" 2>/dev/null \
      && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null \
      && pwd -P 2>/dev/null || true)"
    git_dir_candidate="$(cd "$cwd" 2>/dev/null \
      && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null \
      && pwd -P 2>/dev/null || true)"
    if [[ -n "$git_dir_root" && -n "$git_dir_candidate" && "$git_dir_root" == "$git_dir_candidate" ]]; then
      return 0
    fi
  fi

  return 1
}

stop_pidfile() {
  local svc="$1"
  local pidfile="$RUN_DIR/$svc.pid"
  if pid_alive "$pidfile"; then
    local pid
    pid="$(cat "$pidfile")"
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    echo "  $svc  stopping (pid $pid)"
  fi
  rm -f "$pidfile"
}

assert_port_available() {
  local label="$1" port="$2" pids pid cwd
  pids="$(listener_pids "$port")"
  if [[ -n "$pids" ]]; then
    for pid in $pids; do
      if pid_owned_by_kitty "$pid"; then
        cwd="$(pid_cwd "$pid")"
        if [[ "$cwd" == "$KITTY_ROOT" || "$cwd" == "$KITTY_ROOT/"* ]]; then
          echo "Error: $label port :$port is held by a leftover Kitty process from this checkout" >&2
          echo "  pid $pid: $(pid_command "$pid")" >&2
          echo "  Run './kitty down' to clean up." >&2
        else
          echo "Error: $label port :$port is held by another Kitty worktree" >&2
          echo "  pid $pid: $(pid_command "$pid")" >&2
          echo "  worktree: ${cwd:-unknown}" >&2
          echo "  Stop it with: (cd \"$cwd\" && ./kitty down)" >&2
        fi
        return 1
      fi
    done
    echo "Error: $label port :$port is already owned by pid(s): $pids" >&2
    for pid in $pids; do
      echo "  pid $pid: $(pid_command "$pid")" >&2
    done
    echo "Run './kitty down' to stop Kitty-owned listeners; unrelated listeners are never killed." >&2
    return 1
  fi
}

generate_secret() {
  local python="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python" ]]; then
    python="$(command -v python3)"
  fi
  "$python" - <<'PY'
import secrets
print(secrets.token_urlsafe(32))
PY
}

append_env_secret() {
  local key="$1"
  local value="$2"
  local env_file="$KITTY_ROOT/.env"

  if [[ ! -f "$env_file" ]]; then
    umask 077
    : > "$env_file"
  fi

  # Replace, never append. ensure_gateway_secret tests the shell environment
  # rather than the file, so from a shell that had not sourced .env this used to
  # add a second GATEWAY_SECRET with a different value. Readers that take the
  # first match (grep | head -1, and some dotenv loaders) then authenticated
  # with a secret the gateway rejects — a 401 with nothing obviously wrong.
  local tmp
  tmp="$(mktemp "${env_file}.XXXXXX")" || return 1
  chmod 600 "$tmp"
  awk -v key="$key" '
    $0 == "# Generated by ./kitty for local gateway auth" { pending = $0; next }
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "=" { pending = ""; next }
    { if (pending != "") { print pending; pending = "" } print }
    END { if (pending != "") print pending }
  ' "$env_file" > "$tmp"
  {
    echo
    echo "# Generated by ./kitty for local gateway auth"
    echo "$key=$value"
  } >> "$tmp"
  mv "$tmp" "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true
}

ensure_gateway_secret() {
  local secret="${GATEWAY_SECRET:-${KITTY_GATEWAY_SECRET:-}}"
  local generated=0

  if [[ -z "$secret" ]]; then
    secret="$(generate_secret)"
    generated=1
  fi

  if [[ -z "${GATEWAY_SECRET:-}" ]]; then
    append_env_secret "GATEWAY_SECRET" "$secret"
    export GATEWAY_SECRET="$secret"
  fi

  if [[ -z "${KITTY_GATEWAY_SECRET:-}" ]]; then
    append_env_secret "KITTY_GATEWAY_SECRET" "$secret"
    export KITTY_GATEWAY_SECRET="$secret"
  fi

  if [[ "$generated" == "1" ]]; then
    echo "  Generated local gateway secret in .env"
  fi
}

# ── Subcommands ───────────────────────────────────────────────────────────────

startup_identity() {
  local label="$1" port="$2" pid="$3"
  local sha build_id
  sha="$(git -C "$KITTY_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  build_id=""
  if [[ -f "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID" ]]; then
    build_id="$(cat "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID")"
  fi
  printf "  %-10s pid=%-6s port=%-5s checkout=%s sha=%s build=%s\n" \
    "$label" "$pid" "$port" "$KITTY_ROOT" "$sha" "${build_id:-none}"
}

check_ui_freshness() {
  local ui_dir="$KITTY_ROOT/gateway/kitty-chat"
  local stamp="$ui_dir/.next/BUILD_ID"
  if [[ ! -f "$stamp" ]]; then
    return 1  # no build exists
  fi
  local input
  for input in src public package.json package-lock.json tsconfig.json next.config.js next.config.mjs next.config.ts; do
    if [[ -e "$ui_dir/$input" ]]; then
      if [[ "$ui_dir/$input" -nt "$stamp" ]]; then
        echo "  UI        WARNING: $input is newer than last build ($stamp)" >&2
        return 1
      fi
    fi
  done
  return 0
}

cmd_up() {
  echo "Starting Kitty..."
  startup_identity "kitty" "-" "$$"
  ensure_gateway_secret

  # LiteLLM
  if pid_alive "$RUN_DIR/litellm.pid"; then
    echo "  LiteLLM  already running (pid $(cat "$RUN_DIR/litellm.pid"))"
  else
    assert_port_available "LiteLLM" "$LITELLM_PORT"
    nohup bash "$KITTY_ROOT/gateway/start_litellm.sh" \
      >"$LOG_DIR/litellm.log" 2>&1 &
    echo $! >"$RUN_DIR/litellm.pid"
    startup_identity "LiteLLM" "$LITELLM_PORT" "$!"
  fi

  # Gateway
  if pid_alive "$RUN_DIR/gateway.pid"; then
    echo "  Gateway  already running (pid $(cat "$RUN_DIR/gateway.pid"))"
  else
    assert_port_available "Gateway" "$GATEWAY_PORT"
    nohup bash "$KITTY_ROOT/gateway/start_gateway.sh" \
      >"$LOG_DIR/gateway.log" 2>&1 &
    echo $! >"$RUN_DIR/gateway.pid"
    startup_identity "Gateway" "$GATEWAY_PORT" "$!"
  fi

  # Poll up to 15 seconds for gateway to be healthy
  echo "  Waiting for gateway..."
  _i=0
  while [ $_i -lt 15 ]; do
    if http_ok "http://127.0.0.1:$GATEWAY_PORT/health"; then
      echo "  Gateway  healthy ✓  http://127.0.0.1:$GATEWAY_PORT"
      break
    fi
    sleep 1
    _i=$((_i + 1))
  done
  if [ $_i -ge 15 ]; then
    echo "  Gateway  not responding yet — check: kitty logs"
  fi
}

# Start only the Next.js UI, leaving gateway and LiteLLM alone. `up`/`down`
# boot out the launchd jobs `install` created, so anything that just wants the
# UI back — rolling back off Open WebUI, most obviously — must not go through
# them. Returns non-zero when the UI does not come up.
cmd_ui() {
  if ! http_ok "http://127.0.0.1:$UI_PORT/"; then
    assert_port_available "UI" "$UI_PORT"
    echo "Starting UI on http://127.0.0.1:$UI_PORT ..."
    (cd "$KITTY_ROOT/gateway/kitty-chat" \
      && nohup node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p "$UI_PORT" \
        >"$LOG_DIR/ui.log" 2>&1 & echo $! >"$RUN_DIR/ui.pid")
    startup_identity "UI" "$UI_PORT" "$(cat "$RUN_DIR/ui.pid")"
    check_ui_freshness || true
    _i=0
    while [ $_i -lt 30 ]; do
      if http_ok "http://127.0.0.1:$UI_PORT/"; then break; fi
      sleep 1
      _i=$((_i + 1))
    done
  fi

  if http_ok "http://127.0.0.1:$UI_PORT/"; then
    echo "UI ready: http://127.0.0.1:$UI_PORT"
    return 0
  fi
  echo "UI not responding on :$UI_PORT — check: $LOG_DIR/ui.log" >&2
  return 1
}

cmd_start() {
  # One-shot launch: gateway + LiteLLM + UI, then open the browser.
  cmd_up

  if cmd_ui && command -v open >/dev/null 2>&1; then
    open "http://127.0.0.1:$UI_PORT"
  fi
}

cmd_down() {
  echo "Stopping Kitty..."

  # Disable launchd jobs first. Their KeepAlive=true setting otherwise restarts
  # a process immediately after it is killed and leaves the old port occupied.
  for svc in ui gateway litellm; do
    if launchctl print "gui/$(id -u)/com.kitty.$svc" >/dev/null 2>&1; then
      launchctl bootout "gui/$(id -u)/com.kitty.$svc" 2>/dev/null || true
      echo "  $svc  launchd job stopped"
    fi
  done

  # Kill anything on Kitty ports regardless of ownership. The launchd
  # KeepAlive cycle makes "leave unrelated" useless — if a process respawns
  # before kitty start claims the port, the operator loops forever.
  for port in "$UI_PORT" "$GATEWAY_PORT" "$LITELLM_PORT"; do
    for pid in $(listener_pids "$port"); do
      echo "  stopping listener pid $pid on :$port ($(pid_command "$pid" | cut -c1-80))"
      kill -KILL "$pid" 2>/dev/null || true
    done
  done
  sleep 1

  for svc in ui gateway litellm; do
    stop_pidfile "$svc"
  done

  rm -f "$RUN_DIR/ui.pid" "$RUN_DIR/gateway.pid" "$RUN_DIR/litellm.pid"
}

cmd_status() {
  local sha build_id
  sha="$(git -C "$KITTY_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  build_id=""
  if [[ -f "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID" ]]; then
    build_id="$(cat "$KITTY_ROOT/gateway/kitty-chat/.next/BUILD_ID")"
  fi

  echo "Kitty status"
  echo "────────────"
  echo "  checkout     $KITTY_ROOT"
  echo "  source sha   $sha"
  echo "  build id     ${build_id:-none}"
  check_ui_freshness 2>/dev/null && echo "  freshness    current" || echo "  freshness    stale"

  echo
  local svc pidfile pid launch_pid port listener_pid owned_pid cwd
  for svc in ui gateway litellm; do
    pidfile="$RUN_DIR/$svc.pid"
    if pid_alive "$pidfile"; then
      pid=$(cat "$pidfile")
      printf "  %-10s running (pid %s)\n" "$svc" "$pid"
    elif launch_pid="$(launchd_pid "$svc")" && [[ -n "$launch_pid" ]]; then
      printf "  %-10s running via launchd (pid %s)\n" "$svc" "$launch_pid"
    else
      case "$svc" in
        ui) port="$UI_PORT" ;;
        gateway) port="$GATEWAY_PORT" ;;
        litellm) port="$LITELLM_PORT" ;;
      esac
      owned_pid=""
      for listener_pid in $(listener_pids "$port"); do
        if pid_owned_by_kitty "$listener_pid"; then
          owned_pid="$listener_pid"
          break
        fi
      done
      if [[ -n "$owned_pid" ]]; then
        cwd="$(pid_cwd "$owned_pid")"
        printf "  %-10s running (pid %s; discovered owned listener on :%s, cwd %s)\n" \
          "$svc" "$owned_pid" "$port" "${cwd:-unknown}"
      else
        printf "  %-10s not running\n" "$svc"
      fi
    fi
  done

  echo
  echo "Health checks"
  echo "─────────────"

  if http_ok "http://127.0.0.1:$GATEWAY_PORT/health"; then
    echo "  gateway   http://127.0.0.1:$GATEWAY_PORT  ✓"
  else
    echo "  gateway   http://127.0.0.1:$GATEWAY_PORT  ✗  (not responding)"
  fi

  if http_ok "http://127.0.0.1:$LITELLM_PORT/health/readiness" \
       -H "Authorization: Bearer $LITELLM_MASTER_KEY"; then
    echo "  litellm   http://127.0.0.1:$LITELLM_PORT  ✓"
  else
    echo "  litellm   http://127.0.0.1:$LITELLM_PORT  ✗  (not responding)"
  fi

  echo
  echo "Listeners"
  echo "─────────"
  for spec in "UI:$UI_PORT" "Gateway:$GATEWAY_PORT" "LiteLLM:$LITELLM_PORT"; do
    label="${spec%%:*}"
    port="${spec##*:}"
    pids="$(listener_pids "$port")"
    if [[ -n "$pids" ]]; then
      printf "  %-10s :%s pid(s) %s
" "$label" "$port" "$pids"
    else
      printf "  %-10s :%s free
" "$label" "$port"
    fi
  done
}

cmd_doctor() {
  VENV="$KITTY_ROOT/venv"
  if [[ -x "$VENV/bin/python" ]]; then
    "$VENV/bin/python" "$KITTY_ROOT/gateway/doctor.py" "$@"
  else
    python3 "$KITTY_ROOT/gateway/doctor.py" "$@"
  fi
}

cmd_context() {
  local python_bin="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    python_bin="$(command -v python3.12)"
  fi
  PYTHONPATH="$KITTY_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$python_bin" -m gateway.context_receipt "$@"
}

cmd_logs() {
  echo "Tailing gateway, LiteLLM, and UI logs (Ctrl-C to stop)..."
  touch "$LOG_DIR/gateway.log" "$LOG_DIR/litellm.log" "$LOG_DIR/ui.log"
  tail -F "$LOG_DIR/gateway.log" "$LOG_DIR/litellm.log" "$LOG_DIR/ui.log"
}

cmd_backup() {
  "$PYTHON_BIN" "$KITTY_ROOT/scripts/kitty_backup.py" backup "$@"
}

cmd_restore_drill() {
  "$PYTHON_BIN" "$KITTY_ROOT/scripts/kitty_backup.py" restore-drill "$@"
}

cmd_install() {
  ensure_gateway_secret
  LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
  mkdir -p "$LAUNCH_AGENTS"

  for svc in gateway litellm; do
    src="$KITTY_ROOT/gateway/com.kitty.$svc.plist"
    dst="$LAUNCH_AGENTS/com.kitty.$svc.plist"

    # Stamp the actual KITTY_ROOT into the plist before installing
    sed "s|__KITTY_ROOT__|$KITTY_ROOT|g" "$src" >"$dst"

    # Unload first so a re-install is idempotent
    launchctl unload "$dst" 2>/dev/null || true
    launchctl load -w "$dst"
    echo "  Installed com.kitty.$svc"
  done

  echo
  echo "Stack will now start automatically on login and restart on crash."
  echo "Run 'kitty status' to verify."
}

cmd_uninstall() {
  LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
  for svc in gateway litellm; do
    dst="$LAUNCH_AGENTS/com.kitty.$svc.plist"
    if [[ -f "$dst" ]]; then
      launchctl unload "$dst" 2>/dev/null || true
      rm "$dst"
      echo "  Removed com.kitty.$svc"
    fi
  done
}

cmd_run_fg() {
  ensure_gateway_secret
  echo "Running gateway in foreground (Ctrl-C to stop)..."
  GATEWAY_RELOAD="${GATEWAY_RELOAD:-1}" bash "$KITTY_ROOT/gateway/start_gateway.sh"
}

cmd_resume() {
  VENV="$KITTY_ROOT/venv"
  if [[ -x "$VENV/bin/python" ]]; then
    "$VENV/bin/python" "$KITTY_ROOT/scripts/resume.py"
  else
    python3.12 "$KITTY_ROOT/scripts/resume.py"
  fi
}

cmd_builder() {
  local python_bin="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    python_bin="$(command -v python3.12)"
  fi
  "$python_bin" -m gateway.builder_cli "$@"
}

cmd_governor() {
  local python_bin="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    python_bin="$(command -v python3.12)"
  fi
  "$python_bin" -m gateway.compute_governor_cli "$@"
}

cmd_tutor() {
  local python_bin="$KITTY_ROOT/venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    python_bin="$(command -v python3.12)"
  fi
  "$python_bin" -m gateway.tutor_cli "$@"
}

cmd_delegate() {
  local action_id="${1:-}"
  if [[ -z "$action_id" ]]; then
    echo "Usage: kitty delegate <action-id>" >&2
    exit 1
  fi
  "$PYTHON_BIN" -m gateway.delegation "$action_id"
}

cmd_push() {
  local alert=0
  local message=""
  for arg in "$@"; do
    case "$arg" in
      --alert) alert=1 ;;
      *) message="$arg" ;;
    esac
  done
  if [[ -z "$message" ]]; then
    echo "Usage: kitty push [--alert] \"message\"" >&2
    exit 1
  fi
  local kind="info"
  [[ "$alert" -eq 1 ]] && kind="alert"
  PYTHONPATH="$KITTY_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -c '
import sys
from gateway.push import push_to_jacob
ok = push_to_jacob(sys.argv[1], kind=sys.argv[2], title="Kitty")
print("sent" if ok else "failed — see logs/push_log.jsonl")
sys.exit(0 if ok else 1)
' "$message" "$kind"
}

cmd_usage() {
  PYTHONPATH="$KITTY_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" \
    "$KITTY_ROOT/scripts/analyze_claude_usage.py" "$@"
}

cmd_sweep() {
  PYTHONPATH="$KITTY_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -c '
import json
from gateway.deadline_sweep import sweep
report = sweep(push_fn=None)
print(json.dumps(report, indent=2, default=str))
'
}

cmd_project() {
  local sub="${1:-}"
  shift || true
  local base="http://127.0.0.1:$GATEWAY_PORT"

  if [[ -z "${GATEWAY_SECRET:-}" ]]; then
    echo "GATEWAY_SECRET not set — run: kitty up (it writes one into .env)" >&2
    exit 1
  fi

  # All output shaping happens in one python helper so quoting in project
  # names can never break the shell or the JSON.
  project_py() {
    PYTHONPATH="$KITTY_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - "$@" <<'PY'
import json
import os
import sys
import urllib.error
import urllib.request

try:
    # Both expected to be set by cmd_project() before this heredoc runs;
    # treat absent as a hard fail so we don't chase a phantom error through
    # the rest of the function. See audit §2.4 / AUDIT_FULL_ENGINEERING_2026-07-20.md.
    base = os.environ["KITTY_PROJECT_BASE"]
    secret = os.environ["GATEWAY_SECRET"]
except KeyError as exc:
    missing = exc.args[0]
    print(
        f"missing env var: {missing} — run: kitty up "
        f"(it writes GATEWAY_SECRET into .env)",
        file=sys.stderr,
    )
    sys.exit(2)
mode = sys.argv[1]
args = sys.argv[2:]


def call(method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        base + path,
        data=data,
        method=method,
        headers={"Authorization": f"Bearer {secret}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        print(f"gateway said {exc.code}: {body}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as exc:
        print(f"can't reach the gateway at {base} — is it up? ({exc.reason})", file=sys.stderr)
        sys.exit(1)


